{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",

    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": ["src"],
  "exclude": ["node_modules"]
}